# ==============================================================================
# PRATYAKSH-Ω Environment Configuration Template
# Copy this file to .env and adjust variables as required for your environment.
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="PRATYAKSH-Ω Disaster Reality Reconstruction"
VERSION="2.4.0"

# Database Configuration (SQLite WAL by default)
DATABASE_URL="sqlite:///./disaster_fog.db"

# CORS Configuration (Comma-separated origins or wildcard patterns)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
CORS_ORIGIN_REGEX="https?://.*-.*\\.vercel\\.app"

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=240
STRICT_RATE_LIMIT_PER_MINUTE=40

# Simulation Settings
DEFAULT_SIMULATION_SPEED=1.0
SIMULATION_START_TIME="2026-08-30T10:30:00Z"
